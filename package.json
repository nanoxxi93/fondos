{
  "name": "fondos",
  "type": "module",
  "version": "1.0.0",
  "description": "Comparador de fondos mutuos ERNI, BBVA y Tyba",
  "main": "legacy/index.js",
  "scripts": {
    "start": "node legacy/index.js",
    "dev": "node --watch legacy/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:bbva": "tsx src/scrapers/bbva/run-local.ts",
    "scrape:erni": "tsx src/scrapers/erni/run-local.ts",
    "scrape:tyba": "tsx src/scrapers/tyba/run-local.ts"
  },
  "keywords": [
    "fondos",
    "erni",
    "bbva",
    "tyba"
  ],
  "author": "Hernando Arima",
  "license": "ISC",
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1148.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.10.1",
    "puppeteer": "^24.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
