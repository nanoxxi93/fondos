{
  "name": "fondos",
  "type": "module",
  "version": "1.0.0",
  "description": "Comparador de fondos mutuos ERNI, BBVA y Tyba",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:bbva": "tsx src/scrapers/bbva/run-local.ts",
    "scrape:erni": "tsx src/scrapers/erni/run-local.ts",
    "scrape:tyba": "tsx src/scrapers/tyba/run-local.ts",
    "api:local": "tsx src/api/run-local.ts",
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "start:server": "node dist/src/server.js",
    "frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "infra:synth": "npm --prefix infra run synth",
    "infra:diff": "npm --prefix infra run diff",
    "infra:deploy": "npm --prefix infra run deploy"
  },
  "keywords": [
    "fondos",
    "erni",
    "bbva",
    "tyba"
  ],
  "author": "Hernando Arima",
  "license": "ISC",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1148.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
